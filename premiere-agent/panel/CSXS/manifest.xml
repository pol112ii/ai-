<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0"
    ExtensionBundleId="com.joybear.ppautocut"
    ExtensionBundleVersion="0.1.0"
    ExtensionBundleName="PP AutoCut"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.joybear.ppautocut.panel" Version="0.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- Premiere Pro. 넓은 버전 범위로 호환 -->
      <Host Name="PPRO" Version="[14.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.joybear.ppautocut.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/autocut.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node.js 사용(파이썬 실행) -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>PP AutoCut</Menu>
          <Geometry>
            <Size>
              <Height>560</Height>
              <Width>380</Width>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
